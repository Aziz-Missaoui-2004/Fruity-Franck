	|!(Cell(F,V)) ? Move(R) / Move(L) : (LANCER_SBIRE)


*(RECHERCHER_PEINTURE) :
	|Cell(F,G) & !(Got(Power)) ? Hit : (RECHERCHER_PEINTURE)
	|Closest(L,J) & !(Got(Power)) ? Move(L) : (RECHERCHER_PEINTURE)
	|Closest(R,J) & !(Got(Power)) ? Move(R) : (RECHERCHER_PEINTURE)
