  |Cell(L,G) ? Turn : (DEPL)
  |Cell(R,G) ? Turn : (DEPL)

*(RECHERCHE_SBIRE) :
	|Closest(P, L) & !(Got(Stuff)) ? Move(L) : (RECHERCHE_SBIRE)
	|Closest(P, R) & !(Got(Stuff)) ? Move(R) : (RECHERCHE_SBIRE)
